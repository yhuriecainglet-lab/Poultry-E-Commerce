# Supabase configuration
# Copy this file to .env.local and fill in your values

# Public Supabase URL (available to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anonymous key (available to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for server-side admin operations that bypass RLS.
# NEVER expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Restrict dashboard access to this email only.
# Leave blank to allow any authenticated user.
ADMIN_EMAIL=you@example.com